#!/usr/bin/env python3
"""abgen-compare — generalized AB-parity run pipeline (stdlib-only CLI).

  abgen-compare run --pointer <x,y | urn | entityId> [--platform mac]
                    [--content URL] [--abcdn URL]
                    [--unity /path/to/Unity --unity-project /path/to/Explorer
                     [--shader-bundle /path/to/scene_ignore_<plat>]
                     [--win-staging DIR]]   # WSL: see abgencompare/wsl.py
                    [--slug NAME] [--runs-root DIR] [--abgen-url URL]
  abgen-compare list  [--runs-root DIR]
  abgen-compare serve [port] [--host ADDR] [--runs-root DIR]
  abgen-compare watch --jit-generated-dir DIR [--abgen-url URL] [--abcdn URL]
                      [--content URL] [--platforms mac,windows] [--runs DIR]
                      [--run-id live-jit] [--interval SECS] [--serve PORT]
                      [--host ADDR]        # live JIT compare (rolling run)
  abgen-compare config [show | set <key> <value> | unset <key>] [--user]
                      # persistent unity_editor/unity_project/win_staging
                      # (CLI > env > <repo>/abgen-compare.json > ~/.config)

run: creates runs/<ts>-<slug>/, fetches the entity's bundles from BOTH the
local abgen JIT server (spawned with a scratch out_root inside the run dir if
none is healthy) and upstream ab-cdn (archives kept), pairs them, and ALWAYS
runs headless analysis (byte diff, objdump structure diff pid/CAB-normalized,
texture decode-compare via texcmp/texpng). With --unity and a configured
harness project it also renders both sides (3 azimuths) and pixel-classifies
(identical=0px, imperceptible<=200ppm, visible above, Δ>8<=200ppm amnesty).
Emits analysis/matrix.jsonl (site schema) + site-data.json. Run dirs are
immutable once COMPLETE; re-runs make new run dirs.
"""
import argparse
import datetime
import json
import os
import sys
from concurrent.futures import ProcessPoolExecutor
from concurrent.futures.process import BrokenProcessPool

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from abgencompare import runmodel, toolconfig  # noqa: E402
from abgencompare.fetch import fetch_side  # noqa: E402
from abgencompare.headless import headless_matrix_rows, split_pairs  # noqa: E402
from abgencompare.localserver import REPO_ROOT, LocalServer  # noqa: E402
from abgencompare.pair import build_pairs  # noqa: E402
from abgencompare.resolve import entity_meta_row, resolve_pointer  # noqa: E402
from abgencompare.sitedata import build_run_sitedata  # noqa: E402
from abgencompare.util import RunLog, append_jsonl, write_json  # noqa: E402

DEFAULT_CONTENT = "https://peer.decentraland.org/content"
DEFAULT_ABCDN = "https://ab-cdn.decentraland.org"


def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")


def _load_pointers(args):
    if args.pointers_file:
        with open(args.pointers_file, encoding="utf-8") as f:
            pts = [ln.strip() for ln in f]
        pts = [p for p in pts if p and not p.startswith("#")]
        if not pts:
            raise SystemExit(f"--pointers-file {args.pointers_file} has no pointers")
        if not args.slug:
            raise SystemExit("--pointers-file requires --slug")
        return pts
    if args.pointer:
        return [args.pointer]
    raise SystemExit("run needs --pointer or --pointers-file")


def _classify_pairs(run_dir, jobs, n_azimuths, classify_fn, log):
    """Fan classify_rendered_pair out over a process pool (workers =
    os.cpu_count()), preserving job order. Returns (results, classify_fail)
    where results is [(row, verdict_tuple), ...] in job order. A per-pair
    exception becomes a fail verdict instead of aborting the run; a broken /
    unavailable pool falls back to an equivalent serial pass."""
    def fail_tuple(exc):
        return ("skipped", "fail", None, None, None, None, {},
                [f"classify raised: {exc!r}"], None)

    results = []
    classify_fail = 0
    if not jobs:
        return results, classify_fail
    try:
        with ProcessPoolExecutor(max_workers=os.cpu_count() or 1) as ex:
            futs = [(r, ex.submit(classify_fn, run_dir, r["pair_id"],
                                  r["kind"], n_azimuths)) for r in jobs]
            for r, fut in futs:
                try:
                    res = fut.result()
                except BrokenProcessPool:
                    raise
                except Exception as e:  # noqa: BLE001 — one bad pair != abort
                    classify_fail += 1
                    log(f"render: classify raised for pair {r['pair_id']}: {e!r}")
                    res = fail_tuple(e)
                results.append((r, res))
        return results, classify_fail
    except Exception as e:  # noqa: BLE001 — pool broke/unavailable
        log(f"render: process pool unusable ({e!r}); classifying serially")
    results, classify_fail = [], 0
    for r in jobs:
        try:
            res = classify_fn(run_dir, r["pair_id"], r["kind"], n_azimuths)
        except Exception as e:  # noqa: BLE001
            classify_fail += 1
            log(f"render: classify raised for pair {r['pair_id']}: {e!r}")
            res = fail_tuple(e)
        results.append((r, res))
    return results, classify_fail


def cmd_run(args):
    root = runmodel.runs_root(args.runs_root)
    os.makedirs(root, exist_ok=True)
    pointers = _load_pointers(args)
    slug = args.slug or pointers[0].replace(",", "_")
    run_id, run_dir = runmodel.new_run_dir(root, slug)
    log = RunLog(run_dir)
    log(f"run {run_id}: {len(pointers)} pointer(s) platform={args.platform}")

    # unity editor + project + win-staging resolve through the persistent
    # tool config (CLI > env > repo abgen-compare.json > ~/.config/…)
    tc, tc_src = toolconfig.effective({
        "unity_editor": args.unity,
        "unity_project": args.unity_project,
        "win_staging": args.win_staging,
    })
    args.unity = tc["unity_editor"]
    args.unity_project = tc["unity_project"]
    args.win_staging = tc["win_staging"]
    if args.no_render and args.unity:
        log("config: --no-render — skipping render stage despite configured unity_editor")
        args.unity = None
    if args.unity:
        log("config: unity_editor=%s (%s) unity_project=%s (%s)" % (
            args.unity, tc_src["unity_editor"],
            args.unity_project, tc_src["unity_project"]))
        from abgencompare import wsl
        # accept Windows-spelled paths when running under WSL (translated so
        # the os.path checks below work; render re-translates for Unity)
        args.unity = wsl.normalize_input(args.unity)
        args.unity_project = wsl.normalize_input(args.unity_project)
        args.shader_bundle = wsl.normalize_input(args.shader_bundle)
        args.win_staging = wsl.normalize_input(args.win_staging)

    shader = args.shader_bundle
    if args.unity and not shader:
        cand = os.path.join(REPO_ROOT, "crate", "shader",
                            f"scene_ignore_{args.platform}")
        shader = cand if os.path.isfile(cand) else None
    config = {
        "run_id": run_id,
        "created": now_iso(),
        "pointer": pointers[0] if len(pointers) == 1 else f"batch:{len(pointers)}",
        "pointers_count": len(pointers),
        "platform": args.platform,
        "content_server": args.content,
        "ab_cdn": args.abcdn,
        "unity": args.unity,
        "unity_project": args.unity_project,
        "shader_bundle": shader,
        "win_staging": args.win_staging,
        "tags": args.tag or [],
        "description": args.description,
        "tier": args.tier,
        "labels": {"upstream": args.upstream_label or "upstream ab-cdn",
                   "ours": "abgen"},
        "thresholds": {"imperceptible_ppm": 200, "amnesty": {"delta_gt": 8, "ppm": 200}},
        "rendered": False,
    }
    if args.unity:
        from abgencompare.render import render_provenance
        config["render_provenance"] = render_provenance(args.unity,
                                                        args.unity_project)
    write_json(os.path.join(run_dir, "config.json"), config, indent=1)

    # 1. resolve (batch: skip unresolvable pointers instead of aborting)
    ents, skipped = [], 0
    for p in pointers:
        try:
            ents.extend(resolve_pointer(args.content, p, log))
        except SystemExit as e:
            skipped += 1
            log(f"resolve: SKIP {p!r} ({e})")
    if skipped:
        log(f"resolve: {skipped}/{len(pointers)} pointers unresolvable, skipped")
    if not ents:
        raise SystemExit("no pointers resolved to active entities")
    meta_rows = [entity_meta_row(e) for e in ents]
    append_jsonl(os.path.join(run_dir, "entity-meta.jsonl"), meta_rows)
    for m in meta_rows:
        log(f"resolve: entity {m['entity']} type={m['type']} "
            f"content_files={len(m['content'])}")

    # 2. ours side (local abgen JIT server) + 3. upstream side (ab-cdn)
    ours_summaries, upstream_summaries = [], []
    with LocalServer(run_dir, args.content, prefer_url=args.abgen_url, log=log,
                     force_spawn=args.fresh_ours) as srv:
        for m in meta_rows:
            ours_summaries.append(
                fetch_side(srv.url, "ours", m["entity"], args.platform, run_dir, log)
            )
    for m in meta_rows:
        upstream_summaries.append(
            fetch_side(args.abcdn, "upstream", m["entity"], args.platform, run_dir,
                       log, sleep=args.abcdn_sleep)
        )
    write_json(os.path.join(run_dir, "analysis", "fetch-summary.json"),
               {"ours": ours_summaries, "upstream": upstream_summaries}, indent=1)

    # 3b. render-shader auto-stage: the repo vendors only the windows flavor,
    # and shader CAB names are per-platform (crate/src/cabname.rs) — a
    # windows donor loads on mac but resolves NO material refs (magenta on
    # both sides: the harness-README "vintage gotcha"). So for platforms
    # without a vendored flavor, stage the shader shipped with the fetched
    # entities themselves (exact vintage + platform; ab-cdn serves it at
    # <ver>/<entity>/dcl/scene_ignore_<platform> for v38–v44-era manifests).
    if args.unity and not shader:
        from abgencompare.fetch import stage_upstream_shader
        shader = stage_upstream_shader(run_dir, upstream_summaries, args.abcdn,
                                       args.platform, log)
        if shader:
            config["shader_bundle"] = shader
            write_json(os.path.join(run_dir, "config.json"), config, indent=1)
        else:
            log(f"shader: no scene_ignore_{args.platform} vendored and the "
                f"fetched entities ship none (v49-era manifests list no "
                f"shader) — renders will be skipped; pass --shader-bundle "
                f"with a dcl/scene_ignore_{args.platform} from another entity")

    # 4. pair
    pairs, unfillable = build_pairs(run_id, args.platform, meta_rows,
                                    ours_summaries, upstream_summaries, log)
    append_jsonl(os.path.join(run_dir, "analysis", "pairs.jsonl"), pairs)
    write_json(os.path.join(run_dir, "analysis", "unfillable.json"), unfillable, indent=1)

    comparable, _purged = split_pairs(pairs)

    # 5. headless analysis — ALWAYS runs (headless.py, shared with watch mode)
    ts = now_iso()
    matrix, byte_rows, struct_rows = headless_matrix_rows(
        run_dir, run_id, args.platform, pairs, log, ts, tier=args.tier)
    append_jsonl(os.path.join(run_dir, "analysis", "bytediff.jsonl"), byte_rows)
    append_jsonl(os.path.join(run_dir, "analysis", "structure.jsonl"), struct_rows)
    append_jsonl(os.path.join(run_dir, "analysis", "matrix.jsonl"), matrix)
    dist = {}
    for m in matrix:
        dist[m["label"]] = dist.get(m["label"], 0) + 1
    log(f"headless: {len(matrix)} matrix rows {dist}")

    # 6. optional render + pixel classify (rev 2 rows, newest-wins)
    if args.unity:
        from abgencompare.render import (check_render_stack,
                                         classify_rendered_pair, run_harness)

        azimuths = [float(x) for x in args.azimuths.split(",") if x.strip()]
        n_azimuths = len(azimuths)
        render_size = args.render_size

        renderable = [r for r in comparable if r["kind"] in ("glb", "animated", "texture")]
        if not check_render_stack(args.unity, args.unity_project, shader,
                                  args.platform, log):
            log("render: SKIPPED (preconditions failed) — headless results stand")
        elif renderable:
            # a byte-identical bundle renders identically to upstream — drop it
            # from the Unity job set (pure GPU saving) and emit its render row
            # directly. NEVER skip on mere structural sameness, only true bytes.
            byte_identical = {row["pair"] for row in byte_rows if row.get("identical")}
            to_render = [r for r in renderable if r["pair_id"] not in byte_identical]
            skipped_ident = [r for r in renderable if r["pair_id"] in byte_identical]
            if skipped_ident:
                log(f"render: {len(skipped_ident)} byte-identical pair(s) skipped "
                    f"from Unity render (identical to upstream)")
            if to_render:
                run_harness(run_dir, to_render, args.platform, args.unity,
                            args.unity_project, shader, log,
                            win_staging=args.win_staging,
                            azimuths=azimuths, size=render_size)

            rts = now_iso()
            prov = "rendered in " + config["render_provenance"]["summary"]

            def render_row(r, cls, label, ppm, ppm8, maxd, pxa, idiff, notes):
                return {
                    "pair": r["pair_id"], "rev": 2, "run": run_id,
                    "entity": r["entity"], "bundle": r["cid"],
                    "platform": args.platform, "kind": r["kind"],
                    "chunk": "render",
                    "upstreamVersion": r.get("manifest_version"),
                    "oursSource": r["ours_source"], "bytesProv": "jit",
                    "prov": prov,
                    "class": cls, "label": label, "ppm": ppm, "ppm8": ppm8,
                    "maxd": maxd, "pxPerAngle": pxa, "inventoryDiff": idiff,
                    "notes": notes, "ts": rts,
                }

            classify_jobs = [r for r in to_render if r["kind"] != "texture"]
            results, classify_fail = _classify_pairs(
                run_dir, classify_jobs, n_azimuths, classify_rendered_pair, log)

            rrows, amp_all = [], {}
            for r, (cls, label, ppm, ppm8, maxd, pxa, idiff, notes, amp) in results:
                if amp:
                    amp_all[r["pair_id"]] = amp
                rrows.append(render_row(r, cls, label, ppm, ppm8, maxd, pxa,
                                        idiff, notes))
            for r in skipped_ident:
                if r["kind"] == "texture":
                    continue  # texture verdicts come from decode-compare, no render row
                rrows.append(render_row(
                    r, "identical", "identical", None, None, None, {}, {},
                    ["skipped-render: byte-identical to upstream"]))
            if classify_fail:
                log(f"render: {classify_fail} pair(s) failed classification "
                    f"(recorded as fail rows)")
            if rrows:
                append_jsonl(os.path.join(run_dir, "analysis", "matrix.jsonl"), rrows)
                write_json(os.path.join(run_dir, "analysis", "amp-metrics.json"),
                           amp_all)
                config["rendered"] = True
                write_json(os.path.join(run_dir, "config.json"), config, indent=1)
                log(f"render: {len(rrows)} rev-2 matrix rows "
                    f"({len(results)} rendered, "
                    f"{len(rrows) - len(results)} skipped-identical)")
            animated = [r for r in to_render if r["kind"] == "animated"]
            if animated:
                from abgencompare.motion import motion_rows
                mrows = motion_rows(run_dir, animated)
                if mrows:
                    append_jsonl(os.path.join(run_dir, "analysis", "motion.jsonl"),
                                 mrows)
                    ok = [m for m in mrows if m["frames"]]
                    worst = max((m["maeMean"] for m in ok), default=None)
                    log(f"motion: {len(mrows)} animated pair(s), "
                        f"{len(ok)} with frame series, worst maeMean={worst}")
        else:
            log("render: no renderable pairs")

    # 7. optional negative-control battery + gate verdict — both must land
    # BEFORE the COMPLETE marker (runmodel immutability)
    if args.selftest:
        from abgencompare.selftest import run_selftest
        st = run_selftest(run_dir, pairs, args.platform, log)
        write_json(os.path.join(run_dir, "analysis", "selftest.json"), st,
                   indent=1)
        log(f"selftest: all_detected={st['all_detected']} "
            f"skipped={st['skipped']} blindspots={len(st['blindspots'])}")
    if args.verdict:
        from abgencompare.verdict import evaluate_run
        v = evaluate_run(run_dir, tier=args.tier)
        write_json(os.path.join(run_dir, "analysis", "verdict.json"), v,
                   indent=1)
        log("verdict: pass=%s %s" % (v["pass"], " ".join(
            f"{k}={m['status']}" for k, m in sorted(v["metrics"].items()))))

    # 8. site data + completion
    sd = build_run_sitedata(run_dir, run_id, config)
    write_json(os.path.join(run_dir, "site-data.json"), sd)
    log(f"site-data: {sd['stats']['pairs']} rows, labels={sd['stats']['labels']}")
    runmodel.mark_complete(run_dir)
    log(f"run {run_id}: COMPLETE")
    print(json.dumps({
        "run_id": run_id,
        "run_dir": run_dir,
        "pairs": len(pairs),
        "comparable": len(comparable),
        "labels": sd["stats"]["labels"],
    }, indent=1))
    return 0


def cmd_list(args):
    infos = runmodel.list_runs(runmodel.runs_root(args.runs_root))
    if args.json:
        print(json.dumps(infos, indent=1))
        return 0
    if not infos:
        print("no runs")
        return 0
    for i in infos:
        stats = i.get("stats") or {}
        labels = stats.get("labels") or {}
        lbl = " ".join(f"{k}={v}" for k, v in labels.items() if v)
        print(f"{i['run_id']}  plat={i.get('platform')} "
              f"{'COMPLETE' if i['complete'] else 'partial '} "
              f"pointer={i.get('pointer')!r} rows={stats.get('pairs', '?')} {lbl}")
    return 0


def cmd_config(args):
    if args.action == "show" or not args.action:
        values, sources = toolconfig.effective()
        print(json.dumps({k: {"value": values[k], "source": sources[k]}
                          for k in toolconfig.KEYS}, indent=1))
        return 0
    scope = "user" if args.user else "repo"
    if args.key not in toolconfig.KEYS:
        raise SystemExit(f"unknown key {args.key!r} (known: {list(toolconfig.KEYS)})")
    if args.action == "set":
        if args.value is None:
            raise SystemExit("config set needs <key> <value>")
        path = toolconfig.save({args.key: args.value}, scope)
    else:  # unset
        path = toolconfig.save({args.key: None}, scope)
    print(f"{args.action} {args.key} in {path}")
    return 0


def cmd_serve(args):
    server = os.path.join(REPO_ROOT, "site", "server.py")
    if not os.path.isfile(server):
        raise SystemExit(f"site server missing: {server}")
    cmd = [sys.executable, server, str(args.port),
           "--runs", runmodel.runs_root(args.runs_root),
           "--host", args.host]
    os.execv(sys.executable, cmd)


def cmd_watch(args):
    from abgencompare import watch
    return watch.main(args)


def main():
    ap = argparse.ArgumentParser(prog="abgen-compare", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    r = sub.add_parser("run", help="create + execute a new comparison run")
    r.add_argument("--pointer",
                   help="scene parcel 'x,y', urn pointer, or entity id")
    r.add_argument("--pointers-file",
                   help="file of pointers (one per line, '#' comments ok) — "
                        "batch every entity into ONE run / single Unity launch; "
                        "requires --slug; unresolvable pointers are skipped")
    r.add_argument("--platform", default="mac",
                   choices=["mac", "windows", "linux", "webgl"])
    r.add_argument("--content", default=DEFAULT_CONTENT,
                   help=f"content server (default {DEFAULT_CONTENT})")
    r.add_argument("--abcdn", default=DEFAULT_ABCDN,
                   help=f"upstream ab-cdn base (default {DEFAULT_ABCDN})")
    r.add_argument("--abcdn-sleep", type=float, default=0.5,
                   help="politeness sleep between upstream bundle fetches "
                        "(default 0.5 for the remote CDN; set 0 for a local mirror)")
    r.add_argument("--unity", help="Unity editor binary (enables render stage)")
    r.add_argument("--no-render", action="store_true",
                   help="skip the render stage even if unity_editor is configured (headless-only run)")
    r.add_argument("--unity-project",
                   help="unity-explorer Explorer project dir (harness host)")
    r.add_argument("--shader-bundle",
                   help="scene_ignore_<platform> bundle for the harness")
    r.add_argument("--azimuths", default="35,155,275",
                   help="comma-separated camera azimuths in degrees for the "
                        "harness render (default 35,155,275; fewer = faster)")
    r.add_argument("--render-size", type=int, default=1024,
                   help="square render size in px for the harness "
                        "(default 1024; smaller = faster)")
    r.add_argument("--win-staging",
                   help="WSL only: Windows-visible dir for render-input "
                        "staging when the run dir is on the WSL filesystem "
                        "(default /mnt/c/abgen-runs/<run-id>)")
    r.add_argument("--abgen-url",
                   help="existing local abgen server to reuse "
                        "(default probes http://127.0.0.1:5147, else spawns)")
    r.add_argument("--fresh-ours", action="store_true",
                   help="always spawn a scratch-out_root abgen server (skip "
                        "the healthy-server probe) — required for determinism "
                        "runs, which must not be satisfied by a warm cache")
    r.add_argument("--tier", choices=["prod", "local"], default="prod",
                   help="gate tier: prod = vs production converter output "
                        "(normalized comparison), local = vs det-guid local "
                        "converter (raw CAB/pid identity gated)")
    r.add_argument("--selftest", action="store_true",
                   help="run the in-run negative-control battery after "
                        "analysis (analysis/selftest.json, before COMPLETE)")
    r.add_argument("--verdict", action="store_true",
                   help="evaluate the simval gates after analysis "
                        "(analysis/verdict.json, before COMPLETE)")
    r.add_argument("--upstream-label",
                   help="display label for the upstream side "
                        "(default 'upstream ab-cdn')")
    r.add_argument("--tag", action="append",
                   help="free-form row tag (repeatable; site renders tag chips)")
    r.add_argument("--description", help="run description shown on the site")
    r.add_argument("--slug", help="run dir suffix (default: from pointer)")
    r.add_argument("--runs-root")
    r.set_defaults(fn=cmd_run)

    l = sub.add_parser("list", help="list runs")
    l.add_argument("--runs-root")
    l.add_argument("--json", action="store_true")
    l.set_defaults(fn=cmd_list)

    c = sub.add_parser(
        "config",
        help="show / edit the persistent tool config "
             "(unity_editor, unity_project, win_staging)")
    c.add_argument("action", nargs="?", choices=["show", "set", "unset"],
                   default="show")
    c.add_argument("key", nargs="?")
    c.add_argument("value", nargs="?")
    c.add_argument("--user", action="store_true",
                   help="edit ~/.config/abgen-compare/config.json instead of "
                        "the repo-local abgen-compare.json")
    c.set_defaults(fn=cmd_config)

    s = sub.add_parser("serve", help="serve the compare site over all runs")
    s.add_argument("port", nargs="?", type=int, default=5197)
    s.add_argument("--host", default=os.environ.get("ABGEN_SITE_HOST") or "0.0.0.0",
                   help="bind address (default 0.0.0.0; env ABGEN_SITE_HOST)")
    s.add_argument("--runs-root")
    s.set_defaults(fn=cmd_serve)

    w = sub.add_parser(
        "watch",
        help="live JIT compare: watch an abgen server's generated dir and keep "
             "one rolling run of headless verdicts vs upstream ab-cdn")
    w.add_argument("--jit-generated-dir",
                   default=os.environ.get("ABGEN_JIT_GENERATED_DIR"),
                   help="the abgen server's out_root "
                        "(<dir>/<entity>/<platform>.manifest.json; "
                        "env ABGEN_JIT_GENERATED_DIR)")
    w.add_argument("--abgen-url",
                   default=os.environ.get("ABGEN_URL") or "http://127.0.0.1:5147",
                   help="the live abgen JIT server serving 'ours' bundles "
                        "(default http://127.0.0.1:5147; env ABGEN_URL)")
    w.add_argument("--abcdn",
                   default=os.environ.get("ABGEN_AB_CDN") or DEFAULT_ABCDN,
                   help=f"upstream ab-cdn base (default {DEFAULT_ABCDN}; "
                        "env ABGEN_AB_CDN)")
    w.add_argument("--content",
                   default=os.environ.get("ABGEN_CATALYST_URL") or DEFAULT_CONTENT,
                   help=f"content server for entity resolution "
                        f"(default {DEFAULT_CONTENT}; env ABGEN_CATALYST_URL)")
    w.add_argument("--platforms",
                   default=os.environ.get("ABGEN_PLATFORMS") or "mac,windows",
                   help="comma-separated platform manifests to compare "
                        "(default mac,windows; env ABGEN_PLATFORMS)")
    w.add_argument("--runs", "--runs-root", dest="runs_root",
                   help="runs root holding the rolling run (default <repo>/runs; "
                        "env ABGEN_RUNS_DIR)")
    w.add_argument("--run-id",
                   default=os.environ.get("ABGEN_WATCH_RUN_ID") or "live-jit",
                   help="rolling run dir name (default live-jit)")
    w.add_argument("--interval", type=float,
                   default=float(os.environ.get("ABGEN_WATCH_INTERVAL") or 30),
                   help="seconds between scans of the generated dir (default 30)")
    w.add_argument("--settle", type=float, default=10,
                   help="ignore manifests younger than this many seconds — the "
                        "conversion may still be writing payloads (default 10)")
    w.add_argument("--upstream-sleep", type=float, default=0.25,
                   help="pause between upstream payload downloads — be gentle "
                        "on the CDN, especially during backfill (default 0.25)")
    w.add_argument("--serve", type=int, metavar="PORT",
                   help="also run the compare site on this port (supervised)")
    w.add_argument("--host", default=os.environ.get("ABGEN_SITE_HOST") or "0.0.0.0",
                   help="--serve bind address (default 0.0.0.0; env ABGEN_SITE_HOST)")
    w.add_argument("--batch", type=int, default=10,
                   help="conversions processed between rescans — fresh JIT "
                        "conversions jump a long backfill queue at batch "
                        "boundaries (default 10)")
    w.add_argument("--once", action="store_true",
                   help="single scan+process pass, then exit (testing)")
    w.add_argument("--limit", type=int, default=0,
                   help="process at most N conversions per scan (testing)")
    w.set_defaults(fn=cmd_watch)

    args = ap.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
